# Copy this file to .env and fill in real values. Never commit .env.

# Neon pooled connection string (Settings > Connection string > Pooled)
DATABASE_URL=postgresql://user:pass@ep-foo-bar.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin password hash — generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$...

# Random secret for signing session cookies — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme

# Resend API key (resend.com → API Keys)
RESEND_API_KEY=re_...

# OTP sender address — use onboarding@resend.dev for dev, switch to a verified domain before real users
OTP_FROM_EMAIL=onboarding@resend.dev

# Optional: Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# Optional: Slack incoming webhook URL for cost alerts (leave blank to disable)
SLACK_WEBHOOK_URL=

# Alert when daily org cost crosses this threshold (in cents, default 1000 = $10)
DAILY_COST_ALERT_CENTS=1000

# Alert when a developer's usage spikes this many times above their baseline
DEVELOPER_SPIKE_MULTIPLIER=10.0
